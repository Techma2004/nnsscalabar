NODE_ENV=development
PORT=5000
# HOST=0.0.0.0 (the default) listens on every network interface, so other
# devices on the same wifi/LAN (teachers' laptops, phones, lab PCs) can reach
# this server at your machine's LAN IP — printed in the server's startup log.
# Set HOST=127.0.0.1 instead if you only ever want this reachable from the
# machine it runs on.
HOST=0.0.0.0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nnss_user
DB_PASSWORD=change-this-database-password
DB_NAME=nnss_calabar
DB_POOL_SIZE=10
# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
# Comma-separated list of additional origins allowed to call the API (e.g. a
# real public domain once the school has one). Local/private-network origins
# (localhost, 127.0.0.1, 10.x.x.x, 192.168.x.x, 172.16-31.x.x) are always
# allowed automatically so LAN access works without extra configuration.
FRONTEND_ORIGIN=
TRUST_PROXY=false
# Keep secure cookies enabled for HTTPS deployments. Leave unset to default
# to NODE_ENV=production. Setting this to "false" is only for isolated local
# testing with synthetic data: HTTP can expose session cookies and student
# records, even on a private LAN. Real school data requires HTTPS.
COOKIE_SECURE=

# Used only by npm run seed:admin
INITIAL_ADMIN_CODE=ADM001
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
INITIAL_ADMIN_NAME=NNSS System Administrator
INITIAL_ADMIN_EMAIL=

# Score-sheet scanner (Tesseract OCR — runs locally, no model server needed)
AI_SCORE_IMPORT_ENABLED=true
# 'uv' (default, recommended) runs ocr_score_sheet.py via `uv run`, which
# manages its own Python venv and installs pyproject.toml dependencies
# automatically — no manual pip install on the server. Set to 'python' only
# if uv genuinely cannot be installed on this machine; OCR_PYTHON_BIN then
# must point at an interpreter that already has pytesseract/Pillow installed.
OCR_RUNNER=uv
OCR_PYTHON_BIN=python3
# Max time to wait for a single scan before giving up, in milliseconds.
OCR_TIMEOUT_MS=20000

# Commandant account (npm run seed:commandant)
INITIAL_COMMANDANT_CODE=CMD001
INITIAL_COMMANDANT_PASSWORD=replace-with-a-strong-password
INITIAL_COMMANDANT_NAME=The Commandant
