# Every setting is explained in CONFIGURATION.md (repository root).
#
# EDITING THIS FILE:
#  * Save it as backend/.env  (a file named exactly ".env", NOT ".env.txt").
#  * No spaces around "=".
#  * If a password contains # or spaces, wrap it in double quotes.
#  * On Vercel you do NOT use a .env file: add each setting under
#    Project -> Settings -> Environment Variables instead.
NODE_ENV=production
PORT=5000
# Keep 127.0.0.1 for local-only access (school PC). Not used on Vercel.
HOST=127.0.0.1

# ---------------------------------------------------------------- DATABASE
# PostgreSQL everywhere. The only thing that changes between a local school PC
# and the online server is this one line.
#
# Local Postgres on the school PC:
DATABASE_URL=postgres://nnss_user:change-this-database-password@127.0.0.1:5432/nnss_calabar
# Supabase online (Project -> Connect -> "Transaction pooler", port 6543):
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
#
# SSL is automatic: on for remote hosts (Supabase), off for localhost/LAN.
# Force it with DATABASE_SSL=true or false if ever needed.
# DATABASE_SSL=
# Connections per server instance. Defaults: 10 on a PC, 3 on Vercel.
DB_POOL_SIZE=10

# ---------------------------------------------------------------- SECURITY
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
# Comma-separated extra origins allowed to call the API, e.g. your domain:
#   https://portal.yourschool.edu.ng
FRONTEND_ORIGIN=
# Reverse-proxy hops in front of the app. 0 for direct connections.
# On Vercel leave unset (it uses 1 automatically).
TRUST_PROXY_HOPS=0
# Keep true for HTTPS (Vercel is always HTTPS). "false" only for isolated
# local testing with synthetic data.
COOKIE_SECURE=true

# ---------------------------------------------------------------- FILE STORAGE
# Cloudflare R2 (blog/news images). Required on Vercel, optional on a PC
# (without it, images are saved to the local uploads folder).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Public URL of the bucket (r2.dev URL or your custom domain), no trailing slash:
# R2_PUBLIC_URL=https://files.yourschool.edu.ng

# ---------------------------------------------------------------- FIRST ADMIN
# Used only by npm run seed:admin
INITIAL_ADMIN_CODE=ADM001
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
INITIAL_ADMIN_NAME=NNSS System Administrator
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PHONE=
# optional: admin (default) or commandant
INITIAL_ADMIN_ROLE=admin

# Commandant account (npm run seed:commandant)
INITIAL_COMMANDANT_CODE=CMD001
INITIAL_COMMANDANT_PASSWORD=replace-with-a-strong-password
INITIAL_COMMANDANT_NAME=The Commandant
INITIAL_COMMANDANT_EMAIL=
INITIAL_COMMANDANT_PHONE=

# ---------------------------------------------------------------- OCR (score-sheet scanner)
# OFF on Vercel (serverless cannot run Tesseract). Defaults to false there.
# Set true only on a machine that has uv + Tesseract (e.g. the school PC).
AI_SCORE_IMPORT_ENABLED=false
OCR_RUNNER=uv
OCR_PYTHON_BIN=python3
OCR_TIMEOUT_MS=60000
# Windows only, if Tesseract is installed in a non-standard folder:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
